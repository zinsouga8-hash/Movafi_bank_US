# MOVAFI BANK UNITED STATES - Environment Configuration
PORT=3000
NODE_ENV=development
APP_URL="https://movafibank.com"
BACKEND_URL="https://movafibank.com"

# Supabase Configuration (Optional for cloud sync; local storage engine runs automatically)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Resend Email Service (Optional; falls back to automated internal log if omitted)
RESEND_API_KEY="re_sample_key"
RESEND_FROM_EMAIL="concierge@movafibank.com"
SUPPORT_EMAIL="concierge@movafibank.com"

# External Payment & Banking Providers (e.g. Stripe, Adyen, Banking Rails)
PAYMENT_PROVIDER_KEY=""
PAYMENT_PROVIDER_SECRET=""

# Card Issuing Processor (e.g. Stripe Issuing, Marqeta)
CARD_PROCESSOR_API_KEY=""
CARD_PROCESSOR_SECRET=""

# Institutional KYC & Compliance Provider
KYC_PROVIDER_KEY=""
KYC_PROVIDER_SECRET=""
